# ==============================================================================
# OPDFlow-AI / DevFusion 4.0 Environment Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Frontend Settings (Vite / Vercel)
# In production on Vercel, set VITE_API_BASE_URL to your deployed backend URL.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Backend Settings (Express / Render)
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# PostgreSQL Connection (Prisma)
# Local: postgresql://postgres:postgres@localhost:5432/devfusion
# Hosted (Neon/Supabase/Render): postgresql://user:pass@host:5432/devfusion?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfusion

# Authentication Secrets (minimum 32 characters, random string in production)
JWT_SECRET=replace_with_a_long_secure_secret_2026_devfusion

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Client Authentication
# Get these credentials from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
