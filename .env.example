# DevFusion 4.0 environment template
# Copy to .env in the project root before running the app.
# Never commit real secrets.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfusion
JWT_SECRET=replace_with_a_long_secure_secret_2026_devfusion
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
