# ==============================================================================
# OPDFlow-AI / SmartMed AI Environment Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Frontend Settings (Vite / Vercel)
VITE_API_BASE_URL=https://smartmedai.onrender.com/api/v1

# Firebase Client Authentication
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=smartmedai-30fce.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartmedai-30fce
VITE_FIREBASE_STORAGE_BUCKET=smartmedai-30fce.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=220976708741
VITE_FIREBASE_APP_ID=1:220976708741:web:8562e2abb77fae0198bdec
VITE_FIREBASE_MEASUREMENT_ID=G-RGNK9QLVPC

# Backend Settings (Express / Render)
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://smart-med-ai-beryl.vercel.app,http://localhost:5173
BACKEND_URL=https://smartmedai.onrender.com

# PostgreSQL Connection (Prisma)
# Supabase: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Authentication Secrets (minimum 32 characters)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
