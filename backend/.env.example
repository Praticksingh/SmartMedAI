# Backend Environment Template
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Managed PostgreSQL (Neon, Supabase, Render PostgreSQL)
# For remote databases, append ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/devfusion

# Authentication (Minimum 32 characters)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=optional_cloudinary_name
CLOUDINARY_API_KEY=optional_cloudinary_api_key
CLOUDINARY_API_SECRET=optional_cloudinary_api_secret
