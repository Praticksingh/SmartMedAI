# Backend Environment Template
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://smart-med-ai-beryl.vercel.app,http://localhost:5173
BACKEND_URL=https://smartmedai.onrender.com

# Managed PostgreSQL (Supabase Session Pooler)
# Append ?sslmode=require
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Authentication (Minimum 32 characters)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
